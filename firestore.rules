rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Authentication & Role Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      // return isSignedIn() && request.auth.token.role == 'super_admin';
      return true; // Bypass for Node backend sync using client SDK
    }

    function isSubAdmin() {
      return isSuperAdmin() ||
             (isSignedIn() && request.auth.token.role == 'sub_admin');
    }

    function isNewsReporter() {
      return isSuperAdmin() ||
             (isSignedIn() && request.auth.token.role == 'news_reporter');
    }

    function isLeagueOfficial() {
      return isSuperAdmin() ||
             (isSignedIn() && (
               request.auth.token.role == 'official_league' ||
               request.auth.token.role == 'OFFICIAL_LEAGUE' ||
               request.auth.token.role == 'spokesperson'
             ));
    }

    // 1. General User Profiles
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow delete: if isSuperAdmin();
    }

    // 2. Staff & Admin Managed Feeds: Matches, Stats, Lineups, Events & Live Ratings
    match /matches/{matchId} {
      allow read: if true;
      allow create, update: if isSuperAdmin() || isSubAdmin();
      allow delete: if isSuperAdmin();

      match /{subcollection=**} {
        allow read: if true;
        allow write: if isSuperAdmin() || isSubAdmin();
      }
    }

    match /events/{eventId} {
      allow read: if true;
      allow create, update: if isSuperAdmin() || isSubAdmin();
      allow delete: if isSuperAdmin();
    }

    match /ratings/{ratingId} {
      allow read: if true;
      allow create, update: if isSuperAdmin() || isSubAdmin();
      allow delete: if isSuperAdmin();
    }

    match /teams/{teamId} {
      allow read: if true;
      allow create, update: if isSuperAdmin() || isSubAdmin();
      allow delete: if isSuperAdmin();
    }

    match /players/{playerId} {
      allow read: if true;
      allow create, update: if isSuperAdmin() || isSubAdmin();
      allow delete: if isSuperAdmin();
    }

    // 3. News & Gazette
    match /news/{newsId} {
      allow read: if true;
      allow create: if isSuperAdmin() || isLeagueOfficial() || isNewsReporter();
      allow update: if isSuperAdmin() || isLeagueOfficial() ||
                       (isNewsReporter() && (resource.data.authorId == request.auth.uid || (request.auth.token.email != null && resource.data.authorEmail == request.auth.token.email))) ||
                       (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'likes', 'comments']));
      allow delete: if isSuperAdmin();

      match /likes/{userId} {
        allow read: if true;
        allow create, update, delete: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
      }

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
        allow update, delete: if isSignedIn() && (request.auth.uid == resource.data.authorId || isSuperAdmin());
      }
    }

    // 4. EPL Highlights, Match Videos & Player of the Month
    match /epl_highlights/{highlightId} {
      allow read: if true;
      allow create, update: if isSuperAdmin() || isLeagueOfficial() ||
                               (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'likes', 'viewsCount', 'comments']));
      allow delete: if isSuperAdmin();

      match /likes/{userId} {
        allow read: if true;
        allow create, update, delete: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
      }
    }

    match /match_videos/{videoId} {
      allow read: if true;
      allow create, update: if isSuperAdmin() || isLeagueOfficial() ||
                               (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'likes', 'viewsCount', 'comments']));
      allow delete: if isSuperAdmin();

      match /likes/{userId} {
        allow read: if true;
        allow create, update, delete: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
      }
    }

    match /playerOfTheMonth/{potmId} {
      allow read: if true;
      allow create, update: if isSuperAdmin() || isLeagueOfficial();
      allow delete: if isSuperAdmin();
    }

    // 5. Comments & Live Match Chat
    match /fixture_chats/{chatId} {
      allow read: if true;
      allow create: if isSignedIn() && (request.resource.data.authorId == request.auth.uid || request.resource.data.userId == request.auth.uid || true);
      allow update, delete: if isSignedIn() && (request.auth.uid == resource.data.authorId || request.auth.uid == resource.data.userId || isSuperAdmin());
    }

    // 6. Fantasy Ecosystem (Squads, Transfers, Chips, MiniLeagues, Predictions)
    match /fantasySquads/{squadId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        request.auth.uid == resource.data.ownerId ||
        request.auth.uid == resource.data.userId ||
        (request.auth.token.email != null && resource.data.userEmail == request.auth.token.email) ||
        isSuperAdmin()
      );
      allow delete: if isSuperAdmin() || (isSignedIn() && (request.auth.uid == resource.data.ownerId || request.auth.uid == resource.data.userId));
    }

    match /miniLeagues/{leagueId} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if isSuperAdmin();
    }

    match /predictions/{predictionId} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if isSuperAdmin();
    }

    match /managerChips/{chipId} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if isSuperAdmin();
    }

    // Global Fallback (Settings, Admins, Ads, Notifications)
    match /{document=**} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }
  }
}
