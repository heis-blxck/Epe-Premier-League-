# ---------------------------------------------------------------------------
# Supabase (required for authentication and cloud data)
# ---------------------------------------------------------------------------
# Public browser-safe values. Also used by the Express server.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional server-side aliases (the server falls back to the VITE_* values).
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# App / auth
# ---------------------------------------------------------------------------
# Public URL of the deployed app. Used in Supabase confirmation / reset links.
APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Firebase (legacy / optional)
# ---------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=

# ---------------------------------------------------------------------------
# AI features (optional)
# ---------------------------------------------------------------------------
GEMINI_API_KEY=

# Set to true to disable Vite HMR/watch mode (used by some hosted editors).
DISABLE_HMR=false
